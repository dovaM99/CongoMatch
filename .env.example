# Copy to .env.local (never commit real values).
# Only EXPO_PUBLIC_* variables reach the app; everything else belongs to the backend.

# ---------- App ----------
# mock = everything runs in memory on the phone (dev). http = real API.
EXPO_PUBLIC_API_MODE=mock
EXPO_PUBLIC_API_URL=https://api.congomatch.app/v1
# Mock mode only: phone numbers (digits, comma separated) treated as admins.
EXPO_PUBLIC_DEV_ADMIN_PHONES=000000000
EXPO_PUBLIC_MEDIA_CDN_URL=https://media.congomatch.app

# ---------- Backend (server side only, never in the app) ----------
DATABASE_URL=postgres://user:password@host:5432/congomatch
REDIS_URL=redis://host:6379
JWT_SECRET=

# SMS OTP
SMS_PROVIDER=africastalking   # or twilio, infobip
SMS_API_KEY=
SMS_USERNAME=
SMS_SENDER_ID=CongoMatch

# Media storage (S3 compatible: AWS S3, Cloudflare R2, Wasabi)
S3_ENDPOINT=
S3_BUCKET=congomatch-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Photo moderation
MODERATION_PROVIDER=aws-rekognition   # or sightengine, hive
MODERATION_API_KEY=
MODERATION_API_SECRET=

# Mobile Money: Congo-Brazzaville (XAF)
MTN_MOMO_CG_SUBSCRIPTION_KEY=
MTN_MOMO_CG_API_USER=
MTN_MOMO_CG_API_KEY=
MTN_MOMO_CG_ENV=sandbox
AIRTEL_CG_CLIENT_ID=
AIRTEL_CG_CLIENT_SECRET=

# Mobile Money: RD Congo (CDF / USD)
MPESA_CD_API_KEY=
MPESA_CD_PUBLIC_KEY=
MPESA_CD_SERVICE_PROVIDER_CODE=
ORANGE_MONEY_CD_CLIENT_ID=
ORANGE_MONEY_CD_CLIENT_SECRET=
ORANGE_MONEY_CD_MERCHANT_KEY=
AIRTEL_CD_CLIENT_ID=
AIRTEL_CD_CLIENT_SECRET=

# Optional aggregator instead of direct operator contracts
AGGREGATOR=   # cinetpay, pawapay, flutterwave
AGGREGATOR_API_KEY=
AGGREGATOR_SITE_ID=

# Push notifications
EXPO_ACCESS_TOKEN=
